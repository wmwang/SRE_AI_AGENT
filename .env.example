# ==================== OpenAI 配置 ====================
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1  # 可選，支援自訂 endpoint

# ==================== Prometheus 配置 (Metrics Analysis) ====================
PROMETHEUS_ENDPOINT=http://localhost:9090
MOCK_PROMETHEUS=false  # 模擬模式（無需真實 Prometheus）

# ==================== Elasticsearch 配置 (Log Analysis) ====================
# Elasticsearch endpoint
ELASTICSEARCH_ENDPOINT=http://localhost:9200

# API Key (放在 HTTP Header)
ELASTICSEARCH_API_KEY=your-api-key-here

# API Key Header 名稱（預設: Authorization）
ELASTICSEARCH_API_KEY_HEADER=Authorization

# 是否使用 Bearer token 格式（預設: true）
ELASTICSEARCH_USE_BEARER=true
# true:  Authorization: Bearer your-api-key
# false: X-API-Key: your-api-key (需搭配自訂 ELASTICSEARCH_API_KEY_HEADER)

# Mock Mode (模擬 Elasticsearch，無需真實環境)
MOCK_ELASTICSEARCH=false

# Log Index Pattern
LOG_INDEX_PATTERN=logs-*

# Max results per query
MAX_LOG_RESULTS=1000

# ==================== Debug 設定 ====================
DEBUG=false           # 一般 Debug
DEBUG_MCP=false       # MCP 通訊 Debug
DEBUG_LLM=false       # LLM 通訊日誌 (記錄到 ~/.sre-agent/llm-debug.log)

# ==================== Shared Memory ====================
SHARED_MEMORY_PATH=:memory:  # 使用記憶體模式