[
  {
    "id": "web-availability",
    "name": "Availability",
    "description": "在指定時間窗口內，成功請求到網頁應用程式的百分比。",
    "target": 99.9,
    "threshold": 99,
    "window": "1 month",
    "golden_signal": "Availability"
  },
  {
    "id": "web-latency",
    "name": "Latency",
    "description": "在指定響應時間閾值內處理的請求百分比。",
    "target": 95,
    "threshold": 200,
    "window": "1 month",
    "golden_signal": "Latency"
  },
  {
    "id": "web-error-rate",
    "name": "Error Rate",
    "description": "所有請求中，返回錯誤響應的百分比。",
    "target": 1,
    "threshold": 2,
    "window": "1 month",
    "golden_signal": "Errors"
  },
  {
    "id": "web-traffic",
    "name": "Traffic",
    "description": "每秒成功請求到網頁應用程式的數量。",
    "target": 1000,
    "window": "1 month",
    "golden_signal": "Traffic"
  },
  {
    "id": "web-saturation",
    "name": "Saturation",
    "description": "網頁應用程式所使用的系統資源（CPU、記憶體）的百分比。",
    "target": 70,
    "threshold": 85,
    "window": "1 month",
    "golden_signal": "Saturation"
  }
]